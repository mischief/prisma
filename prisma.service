[Unit]
Description=Prisma - Elgato Stream Deck Controller
Documentation=man:prisma(1)
BindsTo=dev-streamdeck.device
After=dev-streamdeck.device

[Service]
Type=simple
ExecStart=@bindir@/prisma
Restart=on-failure
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=prisma

# No [Install]: the udev rule's SYSTEMD_USER_WANTS starts this unit when
# the Stream Deck appears, so enabling it would only make it fail at
# login whenever the device is unplugged.
